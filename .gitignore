# ============================================================
# AIOT 视频结构化分析系统 .gitignore
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
build/
dist/
release/

# --- 虚拟环境 ---
.venv/
venv/
env/
ENV/

# --- Claude 工具 ---
.claude/
# Claude 本地指令文件（每个用户不同，不入仓）
**/CLAUDE.md

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ============================================================
# 运行时输出（按需排除：capture_buffer 等可保留空目录结构）
# ============================================================
# 采集输出帧
capture_buffer/
# 协议运行时输出
101_buffer/
201_buffer/
# 标注视频输出
annotated_buffer/
# 日志
logs/
# 临时文件
*.tmp
*.tmp.mp4
*.tmp.bin
# Demo 视频（不入仓，体积大；README 提示用户自备或从远端下载）
VideoCapture/demo_videos/

# ============================================================
# 模型权重（首次运行自动下载，不入仓）
# ============================================================
config/models/
VideoCapture/models/

# ============================================================
# 保留入仓的样例数据
# ============================================================
# assets/*.png                       → 保留（README 截图）
# VideoCapture/demo_videos/*.mp4     → 不入仓（体积大，README 改为提示用户自备）
